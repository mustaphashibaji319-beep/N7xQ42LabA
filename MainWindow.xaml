<Window x:Class="CorelXTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CorelXTools.UI"
        Title="CorelXTools"
        Height="800"
        Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>


        <!-- 顶部一级菜单 -->
        <ui:MainToolbar Grid.Row="0"/>


        <!-- 中间工作区域 -->
        <Grid Grid.Row="1">

            <TextBlock Text="CorelXTools 工作区域"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="28"/>

        </Grid>


        <!-- 动态工具栏 -->
        <ui:DynamicBar Grid.Row="2"/>


    </Grid>

</Window>