<Window x:Class="CorelXTools.UI.ToolWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="500"
        Height="400">


    <Border Background="#252525"
            CornerRadius="8">


        <Grid>


            <Grid.RowDefinitions>

                <RowDefinition Height="40"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>



            <!-- 标题栏 -->

            <Border Grid.Row="0"
                    Background="#333333"
                    MouseDown="TitleBar_MouseDown">


                <Grid>


                    <TextBlock
                        x:Name="TitleText"
                        Text="CorelXTools"
                        Foreground="White"
                        FontSize="15"
                        VerticalAlignment="Center"
                        Margin="15,0"/>



                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">


                        <!-- 最小化 -->

                        <Button
                            Content="—"
                            Width="35"
                            Height="30"
                            Click="Minimize_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>



                        <!-- 关闭 -->

                        <Button
                            Content="×"
                            Width="35"
                            Height="30"
                            Click="Close_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"/>


                    </StackPanel>


                </Grid>


            </Border>




            <!-- 内容区域 -->

            <ContentControl
                Grid.Row="1"
                x:Name="ContentArea"/>



        </Grid>


    </Border>


</Window>